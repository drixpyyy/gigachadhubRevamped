		local function extractNumericAssetId(rawVal)
			if type(rawVal) == "number" then
				local n = math.floor(rawVal)
				return n > 0 and n or nil
			elseif type(rawVal) == "string" then
				local byParam = rawVal:match("[?&]id=(%d+)") or rawVal:match("rbxassetid://(%d+)") or rawVal:match("(%d+)")
				local n = tonumber(byParam)
				return (n and n > 0) and n or nil
			end
			return nil
		end

		local function decodeXmlEntities(str)
			if type(str) ~= "string" or not str:find("&", 1, true) then
				return str
			end
			str = str:gsub("&#x([%da-fA-F]+);", function(hex)
				local code = tonumber(hex, 16)
				if code and code >= 0 and code <= 255 then return string.char(code) end
				if code and utf8 and utf8.char then
					local ok, ch = pcall(utf8.char, code)
					if ok then return ch end
				end
				return ""
			end)
			str = str:gsub("&#(%d+);", function(dec)
				local code = tonumber(dec, 10)
				if code and code >= 0 and code <= 255 then return string.char(code) end
				if code and utf8 and utf8.char then
					local ok, ch = pcall(utf8.char, code)
					if ok then return ch end
				end
				return ""
			end)
			str = str:gsub("&quot;", "\"")
			str = str:gsub("&apos;", "'")
			str = str:gsub("&lt;", "<")
			str = str:gsub("&gt;", ">")
			str = str:gsub("&amp;", "&")
			return str
		end

		-- Step 1 (Luau port): Fetch raw asset bytes from Roblox's assetdelivery pipeline
