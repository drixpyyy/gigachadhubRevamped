			local hit = dexSession.scriptSource[orig] or dexSession.scriptSource[scr]
			if not hit and resolved.matchForScript then
				local matched = resolved.matchForScript(orig)
				if matched and type(matched.source) == "string" and #matched.source > 0 then
					hit = matched.source
					dexSession.scriptSource[orig] = hit
					dexSession.scriptSource[scr] = hit
					dexSession.recoveredMeta[orig] = {
						assetId = resolved.assetId,
