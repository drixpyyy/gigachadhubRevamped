-- CreateMeshPartAsync is the only way to get a MeshPart at the dumped Size.
-- If it fails, return nil so that mesh is NOT loaded (no SpecialMesh fallback = no blobs).
local meshTemplate = {}
local function makeMeshPart(meshId, collision)
	if not meshId or meshId == "" then
		return nil
	end
	local key = tostring(meshId)
	local cached = meshTemplate[key]
	if cached == false then
		return nil
	end
	if cached then
		return cached:Clone()
	end
	local coll = collision or Enum.CollisionFidelity.Box
	local inst = nil
	local ok, res = pcall(function()
		if Content and Content.fromUri then
			return AssetService:CreateMeshPartAsync(Content.fromUri(meshId), {
				CollisionFidelity = coll,
			})
		end
		return AssetService:CreateMeshPartAsync(meshId)
	end)
	if ok and res then
		inst = res
	end
	if not inst then
		ok, res = pcall(function()
			return AssetService:CreateMeshPartAsync(meshId, {
				CollisionFidelity = coll,
			})
		end)
		if ok and res then
			inst = res
		end
	end
	if inst then
		meshTemplate[key] = inst
		return inst:Clone()
	end
	meshTemplate[key] = false
	return nil
end

local function create(r)
	local className = r.c
	if className == "Workspace" then
		return nil
	end
	if className == "MeshPart" then
		local o = makeMeshPart(r.mesh, r.props and r.props.CollisionFidelity)
		if o then
			return o
		end
		return nil -- broken mesh: skip, do not fake it with FileMesh
	end
	-- Dump used Script + RunContext.Client. LocalScript is what actually runs
	-- when we park them in PlayerGui (LocalScripts do not run in Workspace).
	if className == "Script" or className == "LocalScript" then
		local s = Instance.new("LocalScript")
		s.Enabled = false
		return s
	end
	local ok, inst = pcall(Instance.new, className)
	if ok and inst then
		return inst
	end
	return nil
end

local total = #DATA

-- Map tree (DATA[5] = Map)
local MAP_INDEX = 5
local inMap = table.create(total, false)
if not (DATA[MAP_INDEX] and DATA[MAP_INDEX].n == "Map") then
	MAP_INDEX = nil
	for i = 1, total do
		if DATA[i].c == "Model" and DATA[i].n == "Map" then
			MAP_INDEX = i
			break
		end
	end
end
if MAP_INDEX then
	inMap[MAP_INDEX] = true
	for i = 2, total do
		if inMap[DATA[i].p] then
			inMap[i] = true
		end
	end
end

-- Keep the Local folder + scripts so we can convert them to LocalScripts
local inScripts = table.create(total, false)
for i = 1, total do
	local r = DATA[i]
	if r.p == 1 and r.n == "Local" then
		inScripts[i] = true
	end
end
for i = 2, total do
	if inScripts[DATA[i].p] then
		inScripts[i] = true
	end
end

local skip = table.create(total, false)
for i = 2, total do
	local r = DATA[i]
	local parentIsSkipped = (r.p > 1 and skip[r.p] == true)
	local classSkip = SKIP_CLASS[r.c] == true
	local keep = (inMap[i] == true) or (inScripts[i] == true)
	local rootSkip = (r.p == 1 and SKIP_ROOT_NAME[r.n] == true)
	if (not keep) or parentIsSkipped or classSkip or rootSkip then
		skip[i] = true
	end
end

if CONFIG.REPLACE then
	local old = workspace:FindFirstChild(CONFIG.NAME)
	if old then
		old:Destroy()
	end
	local pl = Players.LocalPlayer
	if pl then
		local pg = pl:FindFirstChild("PlayerGui")
		if pg then
			local oldS = pg:FindFirstChild("LoadedMapScripts")
			if oldS then
				oldS:Destroy()
			end
		end
	end
end

local root = Instance.new("Folder")
root.Name = CONFIG.NAME
root.Parent = workspace

local insts = table.create(total)
insts[1] = root

local function getBaseCF()
	local pl = Players.LocalPlayer or Players:FindFirstChildOfClass("Player")
	if not pl then
		return CFrame.new(0, 6, 0)
	end
	local c = pl.Character or pl.CharacterAdded:Wait()
	local hrp = c and (c:FindFirstChild("HumanoidRootPart") or c:WaitForChild("HumanoidRootPart", 5))
	if hrp then
		return hrp.CFrame
	end
	return CFrame.new(0, 6, 0)
end

local fromPivot = CFrame.new(25000, 25000, 25000)
if MAP_INDEX and DATA[MAP_INDEX].props and DATA[MAP_INDEX].props.WorldPivot then
	fromPivot = DATA[MAP_INDEX].props.WorldPivot
end
local dest = getBaseCF() * CONFIG.OFFSET
local delta = dest * fromPivot:Inverse()

-- 1) Create (MeshPart async is cached; yield so we do not freeze)
local made = 0
local meshesOk, meshesFail = 0, 0
for i = 2, total do
	if not skip[i] then
		local r = DATA[i]
		local ok, o = pcall(create, r)
		if not ok then
			o = nil
		end
		if o then
			if r.n and r.n ~= "" then
				pcall(function()
					o.Name = r.n
				end)
			end
			insts[i] = o
			if r.c == "MeshPart" then
				meshesOk = meshesOk + 1
			end
		else
			skip[i] = true -- children of a failed mesh should also drop
			if r.c == "MeshPart" then
				meshesFail = meshesFail + 1
			end
		end
		made = made + 1
		if r.c == "MeshPart" or made % CONFIG.PER_FRAME == 0 then
			yieldFrame()
		end
	end
end

-- anything whose parent failed to create
for i = 2, total do
	local r = DATA[i]
	if r.p > 1 and skip[r.p] then
		skip[i] = true
		insts[i] = nil
	end
end

-- 2) Props (Size on MeshPart is what makes scale correct)
made = 0
for i = 2, total do
	local o = insts[i]
	local r = DATA[i]
	if o and r.props then
		if r.c == "Humanoid" and r.props.MaxHealth ~= nil then
			pcall(setProp, o, "MaxHealth", r.props.MaxHealth)
		end
		-- LocalScripts: use rewritten standalone source when we have it
		if o:IsA("LuaSourceContainer") then
			local src = REWRITTEN_SCRIPTS[r.n]
			if not src and r.props then
				src = r.props.Source
			end
			if src then
				pcall(setProp, o, "Source", src)
			end
			pcall(setProp, o, "Enabled", false)
		end
		for k, v in pairs(r.props) do
			if k == "Source" or k == "Enabled" then
				-- already handled for scripts
			elseif r.c == "MeshPart" and MESHPART_SKIP_PROP[k] then
				-- MeshId is baked in by CreateMeshPartAsync
			else
				if k == "CFrame" or k == "WorldPivot" then
					v = delta * v
				end
				if k == "Anchored" then
					v = true
				end
				pcall(setProp, o, k, v)
			end
		end
		if o:IsA("BasePart") then
			pcall(function()
				o.Anchored = true
			end)
		end
		if r.attrs then
			for k, v in pairs(r.attrs) do
				pcall(o.SetAttribute, o, k, v)
			end
		end
	elseif o and o:IsA("BasePart") then
		pcall(function()
			o.Anchored = true
		end)
	end
	made = made + 1
	if made % CONFIG.PER_FRAME == 0 then
		yieldFrame()
	end
end

-- 3) refs
made = 0
for i = 2, total do
	local o = insts[i]
	local r = DATA[i]
	if o and r.refs then
		for k, idx in pairs(r.refs) do
			local target = insts[idx]
			if target then
				pcall(function()
					o[k] = target
				end)
			end
		end
	end
	made = made + 1
	if made % (CONFIG.PER_FRAME * 2) == 0 then
		yieldFrame()
	end
end

local function parentOne(i)
	local o = insts[i]
	if not o then
		return
	end
	local r = DATA[i]
	local par = insts[r.p]
	if par then
		pcall(function()
			o.Parent = par
		end)
	end
end

-- 4a) structure
made = 0
for i = 2, total do
	local o = insts[i]
	if o and (not o:IsA("BasePart")) then
		parentOne(i)
		made = made + 1
		if made % CONFIG.PER_FRAME == 0 then
			yieldFrame()
		end
	end
end

-- 4b) spatial chunks for parts
local CHUNK = CONFIG.CHUNK_STUDS
local buckets = {}
local keys = {}
local function keyFor(pos)
	local x = math.floor(pos.X / CHUNK)
	local y = math.floor(pos.Y / CHUNK)
	local z = math.floor(pos.Z / CHUNK)
	return x .. "," .. y .. "," .. z, x, y, z
end
local destPos = dest.Position
for i = 2, total do
	local o = insts[i]
	if o and o:IsA("BasePart") then
		local pos = o.CFrame and o.CFrame.Position or destPos
		local key, x, y, z = keyFor(pos)
		local bucket = buckets[key]
		if not bucket then
			local cx = (x + 0.5) * CHUNK
			local cy = (y + 0.5) * CHUNK
			local cz = (z + 0.5) * CHUNK
			local dx, dy, dz = cx - destPos.X, cy - destPos.Y, cz - destPos.Z
			bucket = { iList = {}, dist2 = dx * dx + dy * dy + dz * dz }
			buckets[key] = bucket
			keys[#keys + 1] = key
		end
		bucket.iList[#bucket.iList + 1] = i
	end
end
table.sort(keys, function(a, b)
	return buckets[a].dist2 < buckets[b].dist2
end)
for ki = 1, #keys do
	local list = buckets[keys[ki]].iList
	made = 0
	for li = 1, #list do
		parentOne(list[li])
		made = made + 1
		if made % CONFIG.PER_FRAME == 0 then
			yieldFrame()
		end
	end
	yieldFrame()
end

-- 5) LocalScripts only run in PlayerGui / character / PlayerScripts — not Workspace.
local pl = Players.LocalPlayer or Players:FindFirstChildOfClass("Player")
local movedScripts = 0
if pl then
	local pg = pl:FindFirstChild("PlayerGui") or pl:WaitForChild("PlayerGui", 5)
	if pg then
		local holder = pg:FindFirstChild("LoadedMapScripts")
		if holder then
			holder:Destroy()
		end
		holder = Instance.new("Folder")
		holder.Name = "LoadedMapScripts"
		holder.Parent = pg
		local dump = {}
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("LocalScript") then
				dump[#dump + 1] = d
			end
		end
		for i = 1, #dump do
			pcall(function()
				dump[i].Parent = holder
				dump[i].Enabled = true
			end)
			movedScripts = movedScripts + 1
		end
	end
end

-- Run rewritten scripts now (loadstring) so they work even if LocalScript.Source is locked.
local ran = 0
for name, src in pairs(REWRITTEN_SCRIPTS) do
	task.spawn(function()
		local fn, err = loadstring(src)
		if not fn then
			warn("[LoadedMap] script compile failed", name, err)
			return
		end
		local ok, e = pcall(fn)
		if not ok then
			warn("[LoadedMap] script error", name, e)
		end
	end)
	ran = ran + 1
end

print("[LoadedMap] done  meshes_ok=" .. meshesOk .. "  meshes_skip=" .. meshesFail .. "  scripts=" .. movedScripts .. "  rewritten=" .. ran .. "  chunks=" .. tostring(#keys))
