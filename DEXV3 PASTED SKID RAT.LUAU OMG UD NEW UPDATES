	ScriptViewer.InspectRecoveredAsset = function(targetInst)
		local editor = createEditor(nil)
		editor.Window:SetTitle(targetInst.Name .. " - Asset Tree & Scripts")
		editor.CodeFrame:SetText("-- Scanning TextureId / Asset IDs for " .. getPath(targetInst) .. "...")
		editor.Window:ShowAndFocus()

		task.spawn(function()
			local t0 = tick()
			local resolved, errMsg = nil, "Asset recovery unavailable."
			if env.resolveContainerAssetData then
				resolved, errMsg = env.resolveContainerAssetData(targetInst, function(msg)
					editor.CodeFrame:SetText("-- " .. tostring(msg))
				end)
			end

			if not resolved then
				editor.CodeFrame:SetText(string.format(
					"-- Target: %s\n-- Asset Recovery Failed: %s",
					getPath(targetInst),
					tostring(errMsg)
				))
				return
			end

			local out = {
				string.format("-- Target: %s", getPath(targetInst)),
				string.format("-- Real %s ID Found: %d | Catalog Name: %s (%.2fs)", tostring(resolved.assetTypeName), resolved.assetId, tostring(resolved.catalogName), tick() - t0),
				"-- Virtual Asset Tree Structure:"
			}
			for i = 1, math.min(#resolved.treeLines, 120) do
				out[#out + 1] = "--   " .. resolved.treeLines[i]
			end
			if #resolved.scripts == 0 then
				out[#out + 1] = "\n-- (No embedded script sources were found in this asset payload.)"
			else
				for idx, entry in ipairs(resolved.scripts) do
					out[#out + 1] = string.format(
						"\n-- =====================================================================\n-- [%d/%d] [%s] %s\n-- =====================================================================\n%s",
						idx, #resolved.scripts, entry.className, entry.relPath, entry.source
					)
				end
			end
			editor.CodeFrame:SetText(table.concat(out, "\n"))
			editor.Window:Show()
		end)
	end

	ScriptViewer.ViewScript = function(scr)
		local editor = editorsByScript[scr]
		if not editor then
			if mainEditor and not mainEditor.Script and mainEditor.CodeFrame:GetText() == "" then
				editor = mainEditor
			else
				editor = createEditor(scr)
			end
			editorsByScript[scr] = editor
		end
		editor.Script = scr
		editor.CanDump = false
		editor.DumpButton.Interactable = false
		editor.DumpButton.TextColor3 = Color3.new(0.5,0.5,0.5)
		editor.Window:SetTitle(scr.Name.." - Notepad")

		local isClientScript = env.isViableDecompileScript and env.isViableDecompileScript(scr) or false
		local alreadyCached = env.isScriptCached and env.isScriptCached(scr)
		if not alreadyCached then
			if isClientScript then
				editor.CodeFrame:SetText("-- Decompiling "..getPath(scr).."...")
			else
				editor.CodeFrame:SetText("-- Server Script detected: Scanning TextureId / Asset IDs for "..getPath(scr).."...")
			end
		end
		editor.Window:ShowAndFocus()

		task.spawn(function()
			local oldTick = tick()
			local success, source = false, nil
			local recoveredInfo = nil
			local recoveryErr = nil

			if isClientScript and env.decompile and not env.onlyAssetRecoveryDecompile then
				-- Also pre-recover any sibling Server Scripts on the owning Tool/Gear via TextureId in the background
				if env.recoverContainerServerScripts then
					task.spawn(env.recoverContainerServerScripts, scr)
				end
				success, source = pcall(env.decompile, scr)
			end

			if (not success or type(source) ~= "string" or #source == 0) and env.recoverScriptFromAsset then
				local recSrc, metaOrErr = env.recoverScriptFromAsset(scr, function(progressText)
					if editor.Script == scr then
						editor.CodeFrame:SetText("-- Script Path: " .. getPath(scr) .. "\n-- " .. tostring(progressText))
					end
				end)
				if type(recSrc) == "string" and #recSrc > 0 then
					success = true
					source = recSrc
					recoveredInfo = type(metaOrErr) == "table" and metaOrErr or nil
				else
					recoveryErr = metaOrErr
				end
			end

			if not recoveredInfo and env.decompileSession and env.decompileSession.recoveredMeta then
				recoveredInfo = env.decompileSession.recoveredMeta[scr]
			end

			-- The provided default is a template, not recovered server bytecode.
			local original = env.decompileSession and env.decompileSession.snapshotOrigin[scr] or scr
			local character = original.Parent
			local player = character and service.Players:GetPlayerFromCharacter(character)
			if success and player and original:IsA("Script") and original.Name == "Health"
				and original.RunContext ~= Enum.RunContext.Client then
				editor.CodeFrame:SetText(source)
				editor.Window:Show()
				return
			end

			local header = "-- Script Path: "..getPath(scr).."\n"
			if not success or type(source) ~= "string" then
				header = header.."-- Unable to view source.\n"
				if not isClientScript then
					header = header.."-- Reason: The script is not running on client, and public Gear/Asset recovery did not find a match.\n"
					if recoveryErr then
						header = header.."-- Asset Scan: "..tostring(recoveryErr).."\n"
					end
				elseif not env.decompile or env.onlyAssetRecoveryDecompile then
					header = header.."-- Reason: Your executor does not support decompiler.\n"
				else
					header = header.."-- Reason: "..tostring(source).."\n"
				end
				source = header.."-- Executor: "..executorName.." ("..executorVersion..")"
			else
				editor.CanDump = isClientScript and (env.getgc ~= nil)
				editor.DumpButton.Interactable = editor.CanDump
				editor.DumpButton.TextColor3 = editor.CanDump and Color3.new(1,1,1) or Color3.new(0.5,0.5,0.5)
				local cacheTag = (alreadyCached or env.lastDecompileWasCached) and " (Instant Session Cache)" or ""
				local elapsed = tostring(math.floor((tick()-oldTick)*100)/100)
				if recoveredInfo then
					header = header..string.format(
						"-- Recovered via %s Asset Delivery! (ID: %s | Name: %s | Entry: %s)\n",
						tostring(recoveredInfo.assetTypeName or "Catalog"),
						tostring(recoveredInfo.assetId or "?"),
						tostring(recoveredInfo.catalogName or "?"),
						tostring(recoveredInfo.matchedPath or scr.Name)
					)
					header = header.."-- Took "..elapsed.."s"..cacheTag..".\n"
					if type(recoveredInfo.treeLines) == "table" and #recoveredInfo.treeLines > 0 then
						header = header.."-- Asset Hierarchy:\n"
						for i = 1, math.min(#recoveredInfo.treeLines, 25) do
							header = header.."--   "..recoveredInfo.treeLines[i].."\n"
						end
						if #recoveredInfo.treeLines > 25 then
							header = header..string.format("--   ... (%d more nodes)\n", #recoveredInfo.treeLines - 25)
						end
					end
				else
					header = header.."-- Took "..elapsed.."s to decompile"..cacheTag..".\n"
				end
				source = header.."-- Executor: "..executorName.." ("..executorVersion..")\n\n"..source
			end
			editor.CodeFrame:SetText(source)
			editor.Window:Show()
		end)
	end

	return ScriptViewer
end

