	{ c="Decal", n="chaticon", p=13187, props={Color3=Color3.new(1,1,1),Face=Enum.NormalId.Front,Texture="rbxassetid://77955658249798",Transparency=0,ZIndex=1} },
	{ c="Script", n="inventory", p=13185, props={Enabled=true,RunContext=Enum.RunContext.Client,Source="local Players = game:GetService(\"Players\")\
local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\
local StarterGui = game:GetService(\"StarterGui\")\
local UserInputService = game:GetService(\"UserInputService\")\
local RunService = game:GetService(\"RunService\")\
\
local player = Players.LocalPlayer\
local playerGui = player:WaitForChild(\"PlayerGui\")\
local character = nil\
local backpack = nil\
\
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)\
\
local CeeModule = ReplicatedStorage:WaitForChild(\"CeeModule\")\
local Topbar = require(CeeModule:WaitForChild(\"Icon\"))\
local AnimationModule = require(CeeModule:WaitForChild(\"FrameAnimation\"))\
local CanvasAdjuster = require(CeeModule:WaitForChild(\"Canvas\"))\
\
-- UI References (will be updated on reset)\
local InventoryUI = nil\
local BackpackFrame = nil\
local BackpackScroller = nil\
local BackpackTemplate = nil\
local SearchBox = nil\
local ToolbarFrame = nil\
local ToolbarScroller = nil\
local ToolbarTemplate = nil\
\
local toolbarAdjuster = nil\
local backpackAdjuster = nil\
\
local isBackpackOpen = false\
local equippedTool = nil\
local toolbarSlots = {} \
local backpackButtons = {} \
local isDragging = false\
local draggedTool = nil\
local draggedButton = nil\
local dragClone = nil\
local dragStartTime = 0\
local isDragMoved = false\
local searchQuery = \"\"\
\
local toolConnections = {}\
local backpackConnections = {} \
local uiConnections = {}\
\
local toolbarOriginalPos = nil\
local toolbarOriginalSize = nil\
local backpackOriginalPos = nil\
local backpackOriginalSize = nil\
\
local DRAG_THRESHOLD = 25\
local DRAG_DELAY = 0.3\
\
local updateInventory\
\
-- Disconnect all UI connections\
local function disconnectUIConnections()\
	for _, conn in ipairs(uiConnections) do\
		if conn then conn:Disconnect() end\
	end\
	uiConnections = {}\
end\
\
-- Initialize or reinitialize UI references\
local function initializeUIReferences()\
	-- Wait for UI to be ready after reset\
	InventoryUI = playerGui:WaitForChild(\"Inventory\")\
	BackpackFrame = InventoryUI:WaitForChild(\"backpack\")\
	BackpackScroller = BackpackFrame:WaitForChild(\"ScrollingFrame\")\
	BackpackTemplate = InventoryUI.temple:WaitForChild(\"button_backpack\")\
	SearchBox = BackpackFrame:FindFirstChildOfClass(\"TextBox\")\
\
	ToolbarFrame = InventoryUI:WaitForChild(\"toolbar\")\
	ToolbarScroller = ToolbarFrame:WaitForChild(\"ScrollingFrame\")\
	ToolbarTemplate = InventoryUI.temple:WaitForChild(\"button_toolbar\")\
\
	-- Store original positions and sizes\
	toolbarOriginalPos = ToolbarFrame.Position\
	toolbarOriginalSize = ToolbarFrame.Size\
	backpackOriginalPos = BackpackFrame.Position\
	backpackOriginalSize = BackpackFrame.Size\
\
	-- Recreate canvas adjusters\
	if toolbarAdjuster then\
		pcall(function() toolbarAdjuster:Destroy() end)\
	end\
	toolbarAdjuster = CanvasAdjuster.new(ToolbarScroller, {\
		paddingTop = 10,\
		paddingBottom = 10,\
		paddingLeft = 10,\
		paddingRight = 10,\
		updateMode = \"auto\"\
	})\
\
	if backpackAdjuster then\
		pcall(function() backpackAdjuster:Destroy() end)\
	end\
	backpackAdjuster = CanvasAdjuster.new(BackpackScroller, {\
		paddingTop = 10,\
		paddingBottom = 10,\
		axisMode = \"Y\",\
		updateMode = \"auto\"\
	})\
\
	-- Setup search box connection\
	if SearchBox then\
		local searchConn = SearchBox:GetPropertyChangedSignal(\"Text\"):Connect(function()\
			searchQuery = SearchBox.Text\
			updateInventory()\
		end)\
		table.insert(uiConnections, searchConn)\
	end\
end\
\
local function matchesSearch(toolName, query)\
	if query == \"\" then return true end\
	return string.find(string.lower(toolName), string.lower(query)) ~= nil\
end\
\
local function updateHighlight()\
	for i = 1, 5 do\
		if toolbarSlots[i] and toolbarSlots[i].button then\
			local stroke = toolbarSlots[i].button:FindFirstChildOfClass(\"UIStroke\")\
			if stroke then\
				AnimationModule.createTween(stroke, {\
					Color = Color3.fromRGB(80, 80, 90),\
					Thickness = 2\
				}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out):Play()\
			end\
		end\
	end\
\
	for tool, button in pairs(backpackButtons) do\
		local stroke = button:FindFirstChildOfClass(\"UIStroke\")\
		if stroke then\
			AnimationModule.createTween(stroke, {\
				Color = Color3.fromRGB(80, 80, 90),\
				Thickness = 2\
			}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out):Play()\
		end\
	end\
end\
\
local function equipTool(tool)\
	if not tool or not tool:IsDescendantOf(game) then return end\
\
	if not backpack then backpack = player:WaitForChild(\"Backpack\") end\
\
	if equippedTool == tool then\
		tool.Parent = backpack\
		equippedTool = nil\
	else\
		if equippedTool then\
			equippedTool.Parent = backpack\
		end\
		tool.Parent = character\
		equippedTool = tool\
	end\
	updateHighlight()\
end\
\
local function setupToolTracking(tool)\
	if toolConnections[tool] then\
		toolConnections[tool]:Disconnect()\
	end\
\
	local lastParent = tool.Parent\
\
	toolConnections[tool] = tool.AncestryChanged:Connect(function()\
		if not tool or not tool:IsDescendantOf(game) then\
			if toolConnections[tool] then\
				toolConnections[tool]:Disconnect()\
				toolConnections[tool] = nil\
			end\
			return\
		end\
\
		if backpack and tool.Parent == backpack and lastParent == character then\
			if equippedTool == tool then\
				equippedTool = nil\
				updateHighlight()\
			end\
		end\
		lastParent = tool.Parent\
	end)\
end\
\
function updateInventory()\
	if not ToolbarScroller or not BackpackScroller then return end\
\
	for _, child in ipairs(ToolbarScroller:GetChildren()) do\
		if child:IsA(\"GuiButton\") then child:Destroy() end\
	end\
\
	for _, child in ipairs(BackpackScroller:GetChildren()) do\
		if child:IsA(\"GuiButton\") then child:Destroy() end\
	end\
\
	backpackButtons = {}\
\
	if not backpack then backpack = player:WaitForChild(\"Backpack\") end\
\
	local allTools = {}\
	for _, tool in ipairs(backpack:GetChildren()) do\
		if tool:IsA(\"Tool\") then table.insert(allTools, tool) end\
	end\
	if character then\
		for _, tool in ipairs(character:GetChildren()) do\
			if tool:IsA(\"Tool\") then table.insert(allTools, tool) end\
		end\
	end\
\
	for i = 1, 5 do\
		if toolbarSlots[i] and toolbarSlots[i].tool then\
			local tool = toolbarSlots[i].tool\
			local exists = false\
			for _, t in ipairs(allTools) do\
				if t == tool then exists = true break end\
			end\
			if not exists then toolbarSlots[i] = nil end\
		end\
	end\
\
	local toolbarCreated = 0\
	for i = 1, 5 do\
		if toolbarSlots[i] and toolbarSlots[i].tool then\
			local tool = toolbarSlots[i].tool\
			if tool:IsDescendantOf(game) then\
				local button = createToolbarButton(tool, i)\
				toolbarSlots[i].button = button\
				toolbarCreated = toolbarCreated + 1\
			else\
