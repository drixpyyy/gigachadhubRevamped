local executorName = "Unknown"
local executorVersion = "???"
if identifyexecutor then
	local name,ver = identifyexecutor()
	executorName = name
	executorVersion = ver
elseif game:GetService("RunService"):IsStudio() then
	executorName = "Studio"
	executorVersion = version()
end

local function getPath(obj)
	if obj.Parent == nil then
		return "Nil parented"
	end
	return Explorer.GetInstancePath(obj)
end

local function main()
	local ScriptViewer = {}
	local editors,editorsByScript = {},{}
	local activeEditor,mainEditor
	local editorCounter = 0

	-- Path links are resolved, rather than guessed from a regex. This supports
	-- game/workspace/script roots, services, bracket children, Parent and aliases
	-- assigned with either `local x = path` or `x = path`.
	local function validTarget(target)
		return typeof(target) == "Instance" and (target.Parent ~= nil or target == game or Explorer.GetNode(target) ~= nil)
	end

	local function resolveChild(current,name)
		if not validTarget(current) then return nil end
		if name == "Parent" then return current.Parent end
		if current == service.Players and name == "LocalPlayer" then return plr end
		local ok,child = pcall(current.FindFirstChild,current,name)
		if ok then return child end
		return nil
	end

	local function readQuoted(text,pos)
		local quote = text:sub(pos,pos)
		if quote ~= '"' and quote ~= "'" then return nil end
		local out = {}
		local i = pos + 1
		while i <= #text do
			local char = text:sub(i,i)
			if char == quote then return table.concat(out),i + 1 end
			if char == "\\" then
				local nextChar = text:sub(i+1,i+1)
				local escapes = {n = "\n",r = "\r",t = "\t",["\\"] = "\\",['"'] = '"',["'"] = "'"}
				out[#out+1] = escapes[nextChar] or nextChar
				i = i + 2
			else
				out[#out+1] = char
				i = i + 1
			end
		end
		return nil
	end

	local function skipWhitespace(text,pos)
		local whitespace = text:sub(pos):match("^%s*") or ""
		return pos + #whitespace
	end

	local function readCallString(text,pos)
		if text:sub(pos,pos) ~= "(" then return nil end
		local i = skipWhitespace(text,pos+1)
		local value,nextPos = readQuoted(text,i)
		if not value then return nil end
		local closePos = skipWhitespace(text,nextPos)
		local delimiter = text:sub(closePos,closePos)
		if delimiter == ")" then return value,closePos + 1 end
		if delimiter == "," then
			-- FindFirstChild(name, recursive) and WaitForChild(name, timeout)
			-- are still static instance paths when their first argument is literal.
			local close = text:find(")",closePos+1,true)
			if close then return value,close + 1 end
		end
		return nil
	end

	local function parsePath(text,pos,aliases,currentScript)
		local root = text:sub(pos):match("^[%a_][%w_]*")
		if not root then return nil end
		local current
		if root == "game" or root == "Game" then
			current = game
		elseif root == "workspace" or root == "Workspace" then
			current = workspace
		elseif root == "script" then
			current = currentScript
		else
			local alias = aliases[root]
			if alias then current = alias.Target end
		end
		if not validTarget(current) then return nil end

		local rootEnd = pos + #root
		local bestTarget,bestEnd
		if root ~= "game" and root ~= "Game" then
			bestTarget,bestEnd = current,rootEnd
		end
		local cursor = rootEnd
		while cursor <= #text do
			local char = text:sub(cursor,cursor)
			if char == "." then
				local name = text:sub(cursor+1):match("^[%a_][%w_]*")
				if not name then break end
				local target = resolveChild(current,name)
				if not validTarget(target) then break end
				current = target
				cursor = cursor + #name + 1
				bestTarget,bestEnd = current,cursor
			elseif char == "[" then
				local i = skipWhitespace(text,cursor+1)
				local name,nextPos = readQuoted(text,i)
				if not name then break end
				local closePos = skipWhitespace(text,nextPos)
				if text:sub(closePos,closePos) ~= "]" then break end
				local target = resolveChild(current,name)
				if not validTarget(target) then break end
				current = target
				cursor = closePos + 1
				bestTarget,bestEnd = current,cursor
			elseif char == ":" then
				local method = text:sub(cursor+1):match("^[%a_][%w_]*")
				if not method then break end
				local callPos = cursor + #method + 1
				if text:sub(callPos,callPos) ~= "(" then break end
				local arg,nextPos = readCallString(text,callPos)
				if not arg then break end
				local target
				if method == "GetService" and current == game then
					local ok,result = pcall(game.GetService,game,arg)
					if ok then target = result end
				elseif method == "FindFirstChild" or method == "WaitForChild" then
					target = resolveChild(current,arg)
				else
					break
				end
				if not validTarget(target) then break end
				current = target
				cursor = nextPos
				bestTarget,bestEnd = current,cursor
			else
				break
			end
		end
		if bestTarget and bestEnd then
			return {Start = pos,End = bestEnd-1,Target = bestTarget,Expression = text:sub(pos,bestEnd-1)},root
		end
		return nil,root
	end

	local function maskSourceLines(lines)
		local masked = {}
		local blockEquals,blockKind
		for lineNumber,line in ipairs(lines) do
			local chars = {}
			local i = 1
			while i <= #line do
				if blockKind then
					local close = "]"..blockEquals.."]"
					local closePos = line:find(close,i,true)
					local last = closePos and (closePos + #close - 1) or #line
					for j = i,last do chars[j] = " " end
					if closePos then
						i = last + 1
						blockKind,blockEquals = nil,nil
					else
						i = #line + 1
					end
				else
					local two = line:sub(i,i+1)
					local quote = line:sub(i,i)
					local longOpen = line:sub(i):match("^%[(=*)%[")
					if two == "--" then
						local equals = line:sub(i+2):match("^%[(=*)%[")
						if equals then
							local openerLength = #equals + 2
							for j = i,i+openerLength+1 do chars[j] = " " end
							blockKind,blockEquals = "comment",equals
							i = i + openerLength + 2
						else
							for j = i,#line do chars[j] = " " end
							i = #line + 1
						end
					elseif longOpen then
						blockKind,blockEquals = "string",longOpen
						local openerLength = #longOpen + 2
						for j = i,i+openerLength-1 do chars[j] = " " end
						i = i + openerLength
					elseif quote == '"' or quote == "'" or quote == "`" then
						chars[i] = " "
						i = i + 1
						while i <= #line do
							local c = line:sub(i,i)
							chars[i] = " "
							if c == "\\" then
								chars[i+1] = " "
								i = i + 2
							elseif c == quote then
								i = i + 1
								break
							else
								i = i + 1
							end
						end
					else
						chars[i] = quote
						i = i + 1
					end
				end
			end
			masked[lineNumber] = table.concat(chars)
		end
		return masked
	end

	local function scanPaths(lines,currentScript)
		local aliases = {}
		local ranges = {}
		local maskedLines = maskSourceLines(lines)
		for lineNumber,line in ipairs(lines) do
			local masked = maskedLines[lineNumber]
			local lhsPos,lhs = masked:match("^%s*()local%s+([%a_][%w_]*)%s*=")
			if not lhs then lhsPos,lhs = masked:match("^%s*()([%a_][%w_]*)%s*=") end
			local found = {}
			local pos = 1
			while pos <= #masked do
				local startPos = masked:find("[%a_]",pos)
				if not startPos then break end
				local previous = startPos > 1 and masked:sub(startPos-1,startPos-1) or ""
				if not previous:match("[%w_]") and previous ~= "." and previous ~= ":" and startPos ~= lhsPos then
					local link,root = parsePath(line,startPos,aliases,currentScript)
					if link then
						found[#found+1] = link
						pos = math.max(link.End+1,startPos+#root)
					else
						local word = masked:sub(startPos):match("^[%a_][%w_]*") or " "
						pos = startPos + #word
					end
				else
					local word = masked:sub(startPos):match("^[%a_][%w_]*") or " "
					pos = startPos + #word
				end
			end
			table.sort(found,function(a,b)
				if a.Start == b.Start then return a.End > b.End end
				return a.Start < b.Start
			end)
			local accepted,lastEnd = {},0
			for _,link in ipairs(found) do
				if link.Start > lastEnd then
					accepted[#accepted+1] = link
					lastEnd = link.End
				end
			end
			if #accepted > 0 then ranges[lineNumber] = accepted end

			if lhs then
				local equalPos = masked:find("=",lhsPos+#lhs,true)
				if equalPos then
					local rhsPos = skipWhitespace(line,equalPos+1)
					local link = parsePath(line,rhsPos,aliases,currentScript)
					if link then
						aliases[lhs] = {Target = link.Target,Expression = link.Expression}
					else
						aliases[lhs] = nil
					end
				end
			end
		end
		return ranges
	end

	local function buildFunctionDump(scr)
		local getupvalues = (debug and debug.getupvalues) or getupvalues or getupvals
		local getconstants = (debug and debug.getconstants) or getconstants or getconsts
		local getinfo = (debug and (debug.getinfo or debug.info)) or getinfo
		if not env.getgc or not getupvalues or not getconstants or not getinfo then return nil end

		local original = ("\n-- // Function Dumper made by King.Kevin\n-- // Script Path: %s\n\n--[["):format(getPath(scr))
		local dump = original
		local dataBase = {}
		local function addToDump(str,indentation,newLine)
			if newLine == nil then newLine = true end
			dump = dump .. string.rep("\t\t",indentation)..tostring(str)..(newLine and "\n" or "")
		end
		local function functionName(func)
			local ok,info = pcall(getinfo,func)
			local name = ok and info and info.name or ""
			return name ~= "" and name or "Unknown Name"
		end
		local dumpTable,dumpFunction
		function dumpTable(input,indent,index)
			indent = math.max(0,indent)
			addToDump(("%s [%s] %s"):format(tostring(index),typeof(input),tostring(input)),indent-1)
			local count = 0
			for key,value in pairs(input) do
				count = count + 1
				if type(value) == "function" then
					addToDump(("%d [function] = %s"):format(count,functionName(value)),indent)
				elseif type(value) == "table" then
					if not dataBase[value] then
						dataBase[value] = true
						addToDump(("%d [table]:"):format(count),indent)
						dumpTable(value,indent+1,key)
					else
						addToDump(("%d [table] (Recursive table detected)"):format(count),indent)
					end
				else
					addToDump(("%d [%s] = %s"):format(count,typeof(value),tostring(value)),indent)
				end
			end
		end
		function dumpFunction(input,indent)
			addToDump("\nFunction Dump: "..functionName(input),indent)
			addToDump("\nFunction Upvalues: "..functionName(input),indent)
			for index,upvalue in pairs(getupvalues(input)) do
				if type(upvalue) == "function" then
					addToDump(("%d [function] = %s"):format(index,functionName(upvalue)),indent+1)
				elseif type(upvalue) == "table" then
					if not dataBase[upvalue] then
						dataBase[upvalue] = true
						addToDump(("%d [table]:"):format(index),indent+1)
						dumpTable(upvalue,indent+2,index)
					else
						addToDump(("%d [table] (Recursive table detected)"):format(index),indent+1)
					end
				else
					addToDump(("%d [%s] = %s"):format(index,typeof(upvalue),tostring(upvalue)),indent+1)
				end
			end
			addToDump("\nFunction Constants: "..functionName(input),indent)
			for index,constant in pairs(getconstants(input)) do
				if type(constant) == "function" then
					addToDump(("%d [function] = %s"):format(index,functionName(constant)),indent+1)
				elseif type(constant) == "table" then
					if not dataBase[constant] then
						dataBase[constant] = true
						addToDump(("%d [table]:"):format(index),indent+1)
						dumpTable(constant,indent+2,index)
					else
						addToDump(("%d [table] (Recursive table detected)"):format(index),indent+1)
					end
				else
					addToDump(("%d [%s] = %s"):format(index,typeof(constant),tostring(constant)),indent+1)
				end
			end
		end
		for _,func in pairs(env.getgc()) do
			if typeof(func) == "function" then
				local ok,funcEnv = pcall(getfenv,func)
				if ok and funcEnv and funcEnv.script == scr then
					dumpFunction(func,0)
					addToDump("\n"..string.rep("=",100),0,false)
				end
			end
		end
		if dump == original then return nil end
		return dump.."]]"
	end

