							end
						end
					})
					job.waitPending(useOPS and (tonumber(SaveInstanceArgs.DecompileTimeout) or 10) or 60)
				end

				-- 3) Mount frozen t=0 SOI transforms & remount any destroyed/reparented objects, then serialize
				window:SetTitle("Save Instance - Writing Frozen SOI State...")
				local postSpawnIgnore = snapshot and snapshot.mountFrozenState() or nil

				local execArgs = {}
				for k, v in pairs(SaveInstanceArgs) do
					execArgs[k] = v
				end
				local _, excludedInstances = excludedTopLevelRoots()
				local decompileIgnored = {}
				for _, name in ipairs(SaveInstanceArgs.DecompileIgnore) do
					decompileIgnored[#decompileIgnored + 1] = name
				end
				for _, root in ipairs(excludedInstances) do
					decompileIgnored[#decompileIgnored + 1] = root
				end
				execArgs.DecompileIgnore = decompileIgnored
				-- DecompileIgnore only affects source; IgnoreList omits roots,
				-- and optimized mode in bundled SaveInstance enforces the allowlist.
				execArgs.mode = "optimized"
				execArgs.ExtraInstances = {}
				execArgs.ReadMe = false
				execArgs.StudioPlayability = true
				execArgs.AntiIdle = false
				execArgs.NilInstances = false
				execArgs.SaveNotCreatable = false
				execArgs.IgnoreNotArchivable = true
				execArgs.noscripts = not SaveInstanceArgs.Decompile
				if not SaveInstanceArgs.UseOPS then
					execArgs.MaxThreads = 999
					execArgs.DecompileTimeout = 999
					execArgs.timeout = 999
				else
					execArgs.timeout = tonumber(SaveInstanceArgs.DecompileTimeout) or 10
				end
				local ignoreList = {}
				for _, root in ipairs(excludedInstances) do
					ignoreList[#ignoreList + 1] = root
				end
				if postSpawnIgnore then
					for i = 1, #postSpawnIgnore do ignoreList[#ignoreList + 1] = postSpawnIgnore[i] end
				end
				execArgs.IgnoreList = ignoreList

				local prevThrottle = env.bypassDecompileThrottle
				if not SaveInstanceArgs.UseOPS then
					env.bypassDecompileThrottle = true
				end
				-- Always use the bundled core serializer for this window so the
				-- allowlist applies even when the executor has native saveinstance.
				execArgs.FilePath = outFileName:gsub("%.[^%.]+$", "")
				execArgs.Object = false
				execArgs.IsModel = false
				local s, result = pcall(env.coreSaveInstance, execArgs)
				env.bypassDecompileThrottle = prevThrottle
				if not s then error(result) end
				if env.isfile then
					local base = execArgs.FilePath
					local rbxl = pcall(env.isfile, base .. ".rbxl") and env.isfile(base .. ".rbxl")
					local rbxlx = pcall(env.isfile, base .. ".rbxlx") and env.isfile(base .. ".rbxlx")
					if not rbxl and not rbxlx then error("SaveInstance returned but created no .rbxl or .rbxlx file") end
				end
			end)

			if snapshot then
				snapshot.cleanup()
			end

			LabelButton.Gui.Text = "Save"
			Saving = false

			if okRun then
				window:SetTitle("Save Instance - Saved")
			else
				window:SetTitle("Save Instance - Error")
				warn("Failed to save the game: " .. tostring(runErr))
			end
			task.wait(5)
			if not Saving then
				window:SetTitle("Save Instance")
			end
		end)
	end

	return SaveInstance
end

