local AssetService = game:GetService("AssetService")
local Players = game:GetService("Players")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")

local function setProp(o, k, v)
	o[k] = v
end

local function setRef(o, k, target)
	o[k] = target
end

local mCache = {}
local function create(r)
	if r.c == "MeshPart" then
		if r.mesh then
			local t = mCache[r.mesh]
			if t == nil then
				local ok, res = pcall(function()
					return AssetService:CreateMeshPartAsync(Content.fromUri(r.mesh), {
						CollisionFidelity = (r.props and r.props.CollisionFidelity) or Enum.CollisionFidelity.Box
					})
				end)
				t = (ok and res) or false
				mCache[r.mesh] = t
			end
			if t then return t:Clone() end
		end
		local part = Instance.new("Part")
		if r.mesh then
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = Enum.MeshType.FileMesh
			sm.MeshId = r.mesh
			if r.props and r.props.TextureID then sm.TextureId = r.props.TextureID end
			sm.Parent = part
		end
		return part
	end
	return Instance.new(r.c)
end

local total = #DATA
local insts = table.create(total)
for i = 1, total do
	local r = DATA[i]
	local o = create(r)
	if o then o.Name = r.n end
	insts[i] = o
	if i % 250 == 0 then task.wait() end
end

for i = 1, total do
	local o = insts[i]
	local r = DATA[i]
	if o then
		if r.props then
			if r.c == "Humanoid" and r.props.MaxHealth then
				pcall(setProp, o, "MaxHealth", r.props.MaxHealth)
			end
			for k, v in pairs(r.props) do
				if not (r.c == "MeshPart" and (k == "CollisionFidelity" or k == "MeshId")) then
					pcall(setProp, o, k, v)
				end
			end
		end
		if r.attrs then
			for k, v in pairs(r.attrs) do pcall(o.SetAttribute, o, k, v) end
		end
	end
	if i % 250 == 0 then task.wait() end
end

for i = 1, total do
	local o = insts[i]
	local r = DATA[i]
	if o and r.refs then
		for k, idx in pairs(r.refs) do
			local target = insts[idx]
			if target then pcall(setRef, o, k, target) end
		end
	end
	if i % 250 == 0 then task.wait() end
end

for i = 1, total do
	local o = insts[i]
	local r = DATA[i]
	if o and r.p ~= 0 and insts[r.p] then
		o.Parent = insts[r.p]
	end
end

local root = insts[1]
if not root then return end

for i = 1, total do
	local o = insts[i]
	if o and o:IsA("Animation") then
		local kfs = o:FindFirstChildOfClass("KeyframeSequence")
		if kfs then
			local ok, newId = pcall(function()
				return KeyframeSequenceProvider:RegisterKeyframeSequence(kfs)
			end)
			if ok and newId then o.AnimationId = newId end
		end
	end
end

local function getBaseCF()
	local pl = Players.LocalPlayer or Players:FindFirstChildOfClass("Player")
	local c = pl and (pl.Character or pl.CharacterAdded:Wait())
	local hrp = c and c:WaitForChild("HumanoidRootPart", 5)
	if hrp then return hrp.CFrame end
	local sp = workspace:FindFirstChildOfClass("SpawnLocation", true)
	return sp and (sp.CFrame * CFrame.new(0, 4, 0)) or CFrame.new(0, 6, 0)
end

