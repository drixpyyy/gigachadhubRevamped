	{ c="Script", n="music", p=13185, props={Enabled=true,RunContext=Enum.RunContext.Client,Source="local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\
local SettingBoolean = ReplicatedStorage:WaitForChild(\"setting\"):WaitForChild(\"backmusic\")\
\
local PLAYLIST = {\
	\"http://www.roblox.com/asset/?id=9043887091\",\
	\"http://www.roblox.com/asset/?id=1845341094\",\
	\"http://www.roblox.com/asset/?id=9044565954\",\
	\"http://www.roblox.com/asset/?id=9046862941\",\
	\"http://www.roblox.com/asset/?id=9046863579\",\
	\"http://www.roblox.com/asset/?id=9046864489\",\
	\"http://www.roblox.com/asset/?id=1839363112\",\
	\"http://www.roblox.com/asset/?id=1840901237\",\
	\"http://www.roblox.com/asset/?id=1847417433\",\
	\"http://www.roblox.com/asset/?id=1847245265\",\
	\"http://www.roblox.com/asset/?id=1840712882\",\
	\"http://www.roblox.com/asset/?id=1847358730\"\
}\
\
local CONFIG = {\
	Pitch = 0.95,\
	Volume = 0.75\
}\
\
local music = Instance.new(\"Sound\")\
music.Name = \"MusicPlayer\"\
music.Parent = script.Parent\
music.Pitch = CONFIG.Pitch\
music.Volume = CONFIG.Volume\
music.Looped = false\
\
local currentSongIndex = 1\
\
local function playNextSong()\
	if not SettingBoolean.Value then \
		music:Stop()\
		return \
	end\
\
	music.SoundId = PLAYLIST[currentSongIndex]\
	music:Play()\
\
	currentSongIndex = currentSongIndex + 1\
	if currentSongIndex > #PLAYLIST then\
		currentSongIndex = 1\
	end\
end\
\
SettingBoolean:GetPropertyChangedSignal(\"Value\"):Connect(function()\
	if SettingBoolean.Value then\
		if not music.Playing then\
			playNextSong()\
		end\
	else\
		music:Stop()\
	end\
end)\
\
music.Ended:Connect(function()\
	if SettingBoolean.Value then\
		task.wait(0.5)\
		playNextSong()\
	end\
end)\
\
if SettingBoolean.Value then\
	playNextSong()\
end"} },
	{ c="Script", n="CreateTopBar", p=13185, props={Enabled=true,RunContext=Enum.RunContext.Client,Source="local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\
local Players = game:GetService(\"Players\")\
\
local Topbar = require(ReplicatedStorage:WaitForChild(\"CeeModule\"):WaitForChild(\"Icon\"))\
local ChatFrameButton = Topbar:new()\
\
-- Cấu hình icon\
ChatFrameButton:setImage(script.chaticon.Texture)\
ChatFrameButton:setName(\"ChatToggle\")\
\
