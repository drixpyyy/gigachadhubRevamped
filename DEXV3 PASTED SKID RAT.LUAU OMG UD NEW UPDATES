		Explorer.ExportOBJ = function(root,filename)
			if not env.writefile then error("Your executor does not support 'writefile'") end
			local parts = {}
			if root:IsA("BasePart") then parts[#parts+1] = root end
			for _,desc in ipairs(root:GetDescendants()) do
				if desc:IsA("BasePart") then parts[#parts+1] = desc end
			end
			if #parts == 0 then error("The selected object contains no BaseParts to export") end

			local base = filename:gsub("%.obj$","")
			local mtlPath = base..".mtl"
			local mtlName = mtlPath:match("([^/\\\\]+)$") or "DexMaterials.mtl"
			local lines = {"# Dex++ OBJ export","# Native mesh export was unavailable; non-block shapes use bounding geometry.","mtllib "..mtlName}
			local materials,materialList,materialCount = {},{},0
			local corners = {
				Vector3.new(-1,-1,-1),Vector3.new(1,-1,-1),Vector3.new(1,1,-1),Vector3.new(-1,1,-1),
				Vector3.new(-1,-1,1),Vector3.new(1,-1,1),Vector3.new(1,1,1),Vector3.new(-1,1,1)
			}
			local faces = {{1,4,3,2},{5,6,7,8},{1,5,8,4},{2,3,7,6},{1,2,6,5},{4,8,7,3}}
			local vertexOffset = 0

			for partIndex,part in ipairs(parts) do
				local color = part.Color
				local key = string.format("%.4f/%.4f/%.4f/%.4f",color.R,color.G,color.B,part.Transparency)
				local materialIndex = materials[key]
				if not materialIndex then
					materialCount = materialCount + 1
					materialIndex = materialCount
					materials[key] = materialIndex
					materialList[materialIndex] = string.format("newmtl DexMaterial%d\nKd %.6f %.6f %.6f\nd %.6f\nillum 2",materialIndex,color.R,color.G,color.B,1-part.Transparency)
				end
				lines[#lines+1] = "o DexPart"..partIndex.."_"..tostring(part.Name):gsub("[%s\r\n]+","_")
				lines[#lines+1] = "usemtl DexMaterial"..materialIndex
				local pSession = env.decompileSession
				local pCF = (pSession and pSession.frozenCFrame and pSession.frozenCFrame[part]) or part.CFrame
				local pSz = (pSession and pSession.frozenSize and pSession.frozenSize[part]) or part.Size
				for _,corner in ipairs(corners) do
					local point = pCF:PointToWorldSpace(Vector3.new(corner.X*pSz.X/2,corner.Y*pSz.Y/2,corner.Z*pSz.Z/2))
					lines[#lines+1] = string.format("v %.6f %.6f %.6f",point.X,point.Y,point.Z)
				end
				for _,face in ipairs(faces) do
					lines[#lines+1] = string.format("f %d %d %d %d",face[1]+vertexOffset,face[2]+vertexOffset,face[3]+vertexOffset,face[4]+vertexOffset)
				end
				vertexOffset = vertexOffset + 8
			end
			env.writefile(mtlPath,table.concat(materialList,"\n\n").."\n")
			env.writefile(filename,table.concat(lines,"\n").."\n")
			return filename
		end

		Explorer.SaveInstanceToFile = function(obj,filename)
			local extension = tostring(filename:match("%.([^%.]+)$") or "rbxm"):lower()
			if extension == "rbx" then extension = "rbxm" end
			if env.makefolder then pcall(env.makefolder,"SavedDexModels") end

			if extension == "des" then
				if not env.writefile then error("Your executor does not support 'writefile'") end
				local data = Explorer.SerializeDES(obj)
				env.writefile(filename,data)
				return filename
			end

			if extension == "obj" then
				local frozenObj = (obj ~= game and env.forceCloneBypassArchivable) and env.forceCloneBypassArchivable(obj, false) or nil
				local objTarget = frozenObj or obj
				local function cleanupObjClone()
					if frozenObj then pcall(function() frozenObj:Destroy() end) end
				end
				-- Prefer a native full-fidelity mesh exporter when one exists.
				if env.saveinstance and env.saveinstancemode == "native" then
					pcall(env.saveinstance,objTarget,filename,{Decompile = false,ExportType = "obj"})
					if fileExists(filename) then
						local data = readOutput(filename)
						-- An XML model accidentally written with an .obj suffix is not
						-- a successful OBJ export. Empty files are rejected as well.
						if data and not data:find("<roblox",1,true) then cleanupObjClone() return filename end
						if not env.readfile then cleanupObjClone() return filename end
					end
				end
				local okExport, exportRes = pcall(Explorer.ExportOBJ, objTarget, filename)
				cleanupObjClone()
				if not okExport then error(exportRes) end
				return exportRes
			end

			if extension ~= "rbxm" and extension ~= "rbxmx" and extension ~= "rbxl" and extension ~= "rbxlx" then
				error("Unsupported save format: "..extension)
			end
			if not env.saveinstance then error("Your executor does not support 'saveinstance'") end

			-- Freeze target at t=0 via SOI clone bypassing .Archivable so parts/scripts never drift mid-decompile
			local saveTarget = obj
			local frozenClone = nil
			local gameSnapshot = nil
			if obj == game and env.captureGameSOISnapshot then
				gameSnapshot = env.captureGameSOISnapshot({Decompile = true})
				if env.runDecompileBatch then
					local job = env.runDecompileBatch(gameSnapshot.scripts)
					job.waitPending()
				end
			elseif obj ~= game and env.forceCloneBypassArchivable then
				frozenClone = env.forceCloneBypassArchivable(obj, false)
				if frozenClone then
					saveTarget = frozenClone
					if env.runDecompileBatch then
						local scripts = {frozenClone}
						local okD, desc = pcall(frozenClone.GetDescendants, frozenClone)
						if okD and desc then
							for i = 1, #desc do scripts[#scripts + 1] = desc[i] end
						end
						local job = env.runDecompileBatch(scripts)
						job.waitPending()
					end
				end
			end

			local base = filename:gsub("%.[^%.]+$","")
			local captured
			local ignoreList = gameSnapshot and gameSnapshot.mountFrozenState() or nil
			local options = {
				Decompile = true,
				Object = saveTarget,
				IsModel = (extension == "rbxm" or extension == "rbxmx"),
				IgnoreNotArchivable = true,
				IgnoreList = (ignoreList and #ignoreList > 0) and ignoreList or nil,
				-- USSI Object saves require non-optimized mode and ExtraInstances
				-- when the selected object's descendants must be included.
				mode = saveTarget ~= game and "invalid" or nil,
				FilePath = base,
				ExtraInstances = saveTarget ~= game and {saveTarget} or nil,
				Callback = function(data)
					if type(data) == "string" and #data > 0 then captured = data end
				end
			}
			local ok,err
			local function captureReturnedData(value)
				-- A few implementations return serialized bytes instead of using the
				-- callback. Do not mistake ordinary status strings for model data.
				if type(value) == "string" and (value:sub(1,8) == "<roblox!" or value:find("<roblox",1,true)) then
					captured = value
				end
			end
			if env.saveinstancemode == "ussi" then
				ok,err = pcall(env.saveinstance,saveTarget,base,options)
			else
				ok,err = pcall(env.saveinstance,saveTarget,filename,{Decompile = true,ExportType = extension})
			end
			if gameSnapshot then gameSnapshot.cleanup() end
			if frozenClone then pcall(function() frozenClone:Destroy() end) end
			captureReturnedData(err)

			local candidates = {filename,base..".rbxmx",base..".rbxm",base..".rbxlx",base..".rbxl",filename..".rbxmx",base}
			local function correctedTarget(data)
				local isBinary = data:sub(1,8) == "<roblox!"
				local isXML = not isBinary and data:match("^%s*<") ~= nil
				if isXML and extension == "rbxm" then return base..".rbxmx" end
				if isXML and extension == "rbxl" then return base..".rbxlx" end
				if isBinary and extension == "rbxmx" then return base..".rbxm" end
				if isBinary and extension == "rbxlx" then return base..".rbxl" end
				return filename
			end
			local function finish()
				for _,path in ipairs(candidates) do
					local data = readOutput(path)
					if data then
						-- Never disguise XML as a binary extension, or binary data as
						-- an XML extension, when an exporter substitutes its format.
						local target = correctedTarget(data)
						if path ~= target then
							if not env.writefile then error("Output was written as "..path.."; 'writefile' is required to rename it") end
							env.writefile(target,data)
						end
						if target ~= filename then warn("Dex++: requested format unavailable; saved compatible output as "..target) end
						print("Dex++: saved "..target)
						return target
					end
					if fileExists(path) and not env.readfile then
						print("Dex++: saved "..path)
						return path
					end
				end
				if captured then
					local target = correctedTarget(captured)
					if not env.writefile then error("Your executor does not support 'writefile'") end
					env.writefile(target,captured)
					if target ~= filename then warn("Dex++: requested format unavailable; saved compatible output as "..target) end
					print("Dex++: saved "..target)
					return target
				end
				return nil
			end

			local result = finish()
			if result then return result end
			if ok and env.saveinstancemode == "native" and not env.isfile and not env.readfile then
				warn("Dex++: saveinstance completed, but this executor cannot verify the output path")
				return filename
			end
			-- Some native implementations require an extensionless path instead.
			if env.saveinstancemode ~= "ussi" then
				ok,err = pcall(env.saveinstance,obj,base,options)
				captureReturnedData(err)
				result = finish()
				if result then return result end
				-- Finally try the options-only USSI signature. This also handles
				-- executors that preinstall USSI as their global saveinstance.
				ok,err = pcall(env.saveinstance,options)
				captureReturnedData(err)
				result = finish()
				if result then return result end
			end
			error("saveinstance produced no output"..(not ok and err and (": "..tostring(err)) or ""))
		end

